# ==============================================================================
# STYLEORA BACKEND ENVIRONMENT CONFIGURATION (MODULE 1.1 - PRODUCTION DATABASE)
# ==============================================================================

ENVIRONMENT=development
APP_NAME=STYLEORA API
APP_VERSION=1.0.0
DEBUG=true

HOST=0.0.0.0
PORT=8000

# CORS Whitelist (never * in production)
FRONTEND_URL=http://localhost:5173

# Production Supabase PostgreSQL Connection String (Asyncpg driver)
# Note: For Supabase Transaction Pooler (PgBouncer), use port 6543
# Example Direct: postgresql+asyncpg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Example Pooler: postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE

DB_ECHO=false

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute

# External Services (Placeholders - strictly configured in Modules 1.5 & 1.6)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
ADMIN_EMAIL=hello@styleora.me
