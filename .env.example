# ==============================================================================
# STYLEORA ROOT ENVIRONMENT TEMPLATE (VERCEL DEPLOYMENT & LOCAL DEVELOPMENT)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND (Exposed to browser via VITE_ prefix)
# ------------------------------------------------------------------------------
# In production on Vercel same-origin: /api (or /api/v1)
# In local development with separate servers: http://localhost:8000/api/v1
VITE_API_BASE_URL=/api
VITE_RAZORPAY_KEY_ID=

# ------------------------------------------------------------------------------
# BACKEND (Server-only — NEVER expose to frontend or browser)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
APP_NAME=STYLEORA API
APP_VERSION=1.0.0
DEBUG=false

# Supabase PostgreSQL Connection String (Asyncpg)
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE

# CORS Allowed Origins
FRONTEND_URL=https://styleora.me
ADDITIONAL_ALLOWED_ORIGINS=[]

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute

# Razorpay Test Mode Credentials (Backend only)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notifications & Admin
RESEND_API_KEY=
ADMIN_EMAIL=hello@styleora.me